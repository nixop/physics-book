{
  "name": "pole-physics-book",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A bilingual interactive physics reference with synchronized Obsidian knowledge bases.",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "vault": "node scripts/build-content.mjs --vault-only --force-vault",
    "predev": "npm run content",
    "dev": "vite",
    "build": "npm run content && tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run content && vitest run",
    "check": "npm run test && npm run build && npm run visual",
    "visual": "node scripts/run-visual.mjs",
    "visual:against-server": "node scripts/visual-check.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "katex": "^0.16.22",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
